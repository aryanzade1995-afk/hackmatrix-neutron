# Copy to backend/.env and fill in. Never commit the real .env — it is gitignored.
#
# Two connection strings, one per database role. This is where the separation
# actually lives: the admin routes run on a connection that has no grant on the
# identified tables, so a bug in a handler cannot read patient records.
#
# Generate the passwords with:  openssl rand -base64 24
# Apply them with db/schema.sql — see db/README.md.

DATABASE_URL_CLINICIAN=postgresql+psycopg://clinician_role:CHANGE_ME@host:5432/hackmatrix
DATABASE_URL_ADMIN=postgresql+psycopg://admin_role:CHANGE_ME@host:5432/hackmatrix

# Origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# WhatsApp delivery (optional)
#
# Leave these unset and everything else still works; only the "Send to
# WhatsApp" button on the QR panel needs them.
#
# From Twilio Console -> Messaging -> Try it out -> Send a WhatsApp message.
#
# TWILIO_WHATSAPP_FROM is the sender YOUR account uses, including the
# whatsapp: prefix. Do not assume it is the classic sandbox +14155238886 —
# newer Twilio accounts are given their own trial sender instead, and sending
# from the wrong one fails with a confusing error. Check the "From" dropdown
# on that page, or run:
#
#     client.messages.list(limit=1)   # the from_ on your own join reply
# ---------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Where Twilio should fetch the QR image from.
#
# This must be reachable from the public internet. Twilio's API takes a URL,
# not an uploaded file or a base64 blob — its servers fetch the image
# themselves, so http://localhost:8000 will always fail: localhost means
# Twilio's own machine, not yours.
#
# For a local demo, expose the backend with:
#
#     ngrok http 8000
#
# and paste the https:// URL ngrok prints (no trailing slash):
#
#     PUBLIC_BASE_URL=https://a1b2c3d4.ngrok-free.app
#
# On the free tier this URL changes every time ngrok restarts, so it has to be
# updated here and the backend restarted each time.
PUBLIC_BASE_URL=
